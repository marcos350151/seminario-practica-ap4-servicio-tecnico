digraph AP4 { graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.65", label="Arquitectura del prototipo AP4", labelloc=t, fontsize=20, fontname="Arial"]; node [shape=box, style="rounded,filled", color="#1D4766", fillcolor="#EDF6FB", fontname="Arial", fontsize=11]; edge [color="#436477", arrowsize=0.7]; Main [label="Main\nInterfaz consola"]; Repo [label="OrdenRepositorio\nInterfaz"]; DAO [label="OrdenDAO\nDAO + JDBC"]; Model [label="Persona / Cliente / Tecnico\nEquipo / OrdenServicio"]; Proces [label="ProcesoDAO\nTransacciones"]; Rep [label="ReporteOrdenes\nEstadoOrden[] + ArrayList"]; CSV [label="ArchivoOrdenesCsv\nBufferedWriter / Reader"]; DB [shape=cylinder, fillcolor="#E2F3E9", label="MySQL 8\nservicio_tecnico"]; File [shape=note, fillcolor="#FFF3D8", label="ordenes_ap4.csv"]; Main -> {Repo Rep Proces CSV}; Rep -> Repo; Repo -> DAO [label="implementa", dir=back]; DAO -> DB; Proces -> DB; CSV -> File; Rep -> Model; DAO -> Model; }